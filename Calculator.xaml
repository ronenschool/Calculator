<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculator.Calculator"
             Title="Calculator">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
    </VerticalStackLayout>
    <Grid
        Padding="12"
        RowSpacing="8"
        ColumnSpacing="8"
        RowDefinitions="*,*,*,*,*"
        ColumnDefinitions="*,*,*,*">

   
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Stroke="#808080"
            StrokeThickness="1"
            Padding="12">

            <Label x:Name="lblResult"
                Text=""
                FontSize="36"
                HorizontalTextAlignment="End"
                VerticalTextAlignment="Center" />

        </Border>


        1-4+2+3*1


        <Button Grid.Row="1" Grid.Column="0" Text="9" />
        <Button Grid.Row="1" Grid.Column="1" Text="8" />
        <Button Grid.Row="1" Grid.Column="2" Text="7" />
        <Button Grid.Row="1" Grid.Column="3" Text="+" />

     
        <Button Grid.Row="2" Grid.Column="0" Text="6" />
        <Button Grid.Row="2" Grid.Column="1" Text="5" />
        <Button Grid.Row="2" Grid.Column="2" Text="4" />
        <Button Grid.Row="2" Grid.Column="3" Text="-" />

       
        <Button Grid.Row="3" Grid.Column="0" Text="3" />
        <Button Grid.Row="3" Grid.Column="1" Text="2" />
        <Button Grid.Row="3" Grid.Column="2" Text="1" />
        <Button Grid.Row="3" Grid.Column="3" Text="*" />

     
        <Button Grid.Row="4" Grid.Column="0" Text="ac" />
        <Button Grid.Row="4" Grid.Column="1" Text="0" />
        <Button Grid.Row="4" Grid.Column="2" Text="=" />
        <Button Grid.Row="4" Grid.Column="3" Text="/" />

    </Grid>
</ContentPage>