<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculator.Calculator"
             Title="Calculator">

    <Grid Padding="12"
          RowSpacing="8"
          ColumnSpacing="8"
          RowDefinitions="*,*,*,*,*"
          ColumnDefinitions="*,*,*,*">

        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Stroke="#808080"
                StrokeThickness="1"
                Padding="12">

            <Label x:Name="lblResult"
                   Text=""
                   FontSize="36"
                   HorizontalTextAlignment="End"
                   VerticalTextAlignment="Center" />
        </Border>

        <Button Grid.Row="1" Grid.Column="0" Text="9" Clicked="OnButtonClicked" />
        <Button Grid.Row="1" Grid.Column="1" Text="8" Clicked="OnButtonClicked" />
        <Button Grid.Row="1" Grid.Column="2" Text="7" Clicked="OnButtonClicked" />
        <Button Grid.Row="1" Grid.Column="3" Text="+" Clicked="OnButtonClicked" />

        <Button Grid.Row="2" Grid.Column="0" Text="6" Clicked="OnButtonClicked" />
        <Button Grid.Row="2" Grid.Column="1" Text="5" Clicked="OnButtonClicked" />
        <Button Grid.Row="2" Grid.Column="2" Text="4" Clicked="OnButtonClicked" />
        <Button Grid.Row="2" Grid.Column="3" Text="-" Clicked="OnButtonClicked" />

        <Button Grid.Row="3" Grid.Column="0" Text="3" Clicked="OnButtonClicked" />
        <Button Grid.Row="3" Grid.Column="1" Text="2" Clicked="OnButtonClicked" />
        <Button Grid.Row="3" Grid.Column="2" Text="1" Clicked="OnButtonClicked" />
        <Button Grid.Row="3" Grid.Column="3" Text="*" Clicked="OnButtonClicked" />

        <Button Grid.Row="4" Grid.Column="0" Text="ac" Clicked="OnButtonClicked" />
        <Button Grid.Row="4" Grid.Column="1" Text="0" Clicked="OnButtonClicked" />
        <Button Grid.Row="4" Grid.Column="2" Text="=" Clicked="OnButtonClicked" />
        <Button Grid.Row="4" Grid.Column="3" Text="/" Clicked="OnButtonClicked" />

    </Grid>
</ContentPage>
